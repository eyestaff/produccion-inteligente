{
  "name": "produccion-inteligente",
  "private": true,
  "type": "module",
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "sql.js": "^1.14.1"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --ip 127.0.0.1 --port 8787",
    "build": "wrangler build --config worker/wrangler.toml --env production",
    "deploy": "wrangler deploy --config worker/wrangler.toml --env production",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.0",
    "typescript": "5.5.4",
    "vitest": "^1.0.0",
    "wrangler": "^4.0.0"
  }
}
